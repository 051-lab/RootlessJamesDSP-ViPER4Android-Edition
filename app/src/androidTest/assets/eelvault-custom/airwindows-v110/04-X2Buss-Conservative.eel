// Airwindows X2Buss - RootlessJamesDSP LiveProg port
// Algorithmic 1:1 translation of CURRENT X2BussProc.cpp master (Airwindows, MIT License)
// Original: https://github.com/airwindows/airwindows/tree/master/plugins/LinuxVST/src/X2Buss
// Port target: RootlessJamesDSP / JamesDSP EEL2 LiveProg
//
// Preserves current SmoothEQ2-derived four-pass crossover EQ, stepped Bezier
// Dynamics2 envelope system, fader gain, ClipOnly3 output protection and the
// current decorrelated 32-bit float dither. Scientific notation is expanded.
// RootlessJamesDSP executes one sample at a time, so the VST's
// per-callback J-fader interpolation reduces naturally to its target value.

desc: Airwindows X2Buss (RJDSP 1:1 Port)
//tags: airwindows buss eq dynamics console clipper mastering
//author: Airwindows (Chris Johnson), EEL2 port for RootlessJamesDSP
// rjdsp-eel: ignore-divisor overallscale, stepped, spacing -- srate is positive; stepped is guarded; spacing is clamped to 2..32.

high:0.5<0,1,0.001>High
hmid:0.5<0,1,0.001>HMid
lmid:0.5<0,1,0.001>LMid
bass:0.5<0,1,0.001>Bass
highF:0.5<0,1,0.001>High Freq
hmidF:0.5<0,1,0.001>HMid Freq
lmidF:0.5<0,1,0.001>LMid Freq
bassF:0.5<0,1,0.001>Bass Freq
thresh:1.0<0,1,0.001>Threshold
fader:0.5<0,1,0.001>Fader

@init
function aw_xorshift32(v)
(
    v ~= v << 13;
    v ~= (v >> 17) & 32767;
    v ~= v << 5;
    v;
);
function aw_u32(v)
(
    v < 0 ? v + 4294967296 : v;
);
function aw_set_lp(b, freq, res) local(k norm)
(
    k = tan($pi * freq);
    norm = 1.0 / (1.0 + k / res + k * k);
    b[biq_a0] = k * k * norm;
    b[biq_a1] = 2.0 * b[biq_a0];
    b[biq_a2] = b[biq_a0];
    b[biq_b1] = 2.0 * (k * k - 1.0) * norm;
    b[biq_b2] = (1.0 - k / res + k * k) * norm;
);

high = 0.5;
hmid = 0.5;
lmid = 0.5;
bass = 0.5;
highF = 0.5;
hmidF = 0.5;
lmidF = 0.5;
bassF = 0.5;
thresh = 1.0;
fader = 0.5;

biq_freq = 0; biq_reso = 1; biq_a0 = 2; biq_a1 = 3; biq_a2 = 4;
biq_b1 = 5; biq_b2 = 6; biq_sL1 = 7; biq_sL2 = 8; biq_sR1 = 9; biq_sR2 = 10; biq_total = 11;
bez_AL = 0; bez_BL = 1; bez_CL = 2; bez_InL = 3; bez_UnInL = 4; bez_SampL = 5;
bez_AR = 6; bez_BR = 7; bez_CR = 8; bez_InR = 9; bez_UnInR = 10; bez_SampR = 11; bez_cycle = 12; bez_total = 13;

mem = 0;
highA = mem; mem += biq_total; highB = mem; mem += biq_total; highC = mem; mem += biq_total;
midA = mem; mem += biq_total; midB = mem; mem += biq_total; midC = mem; mem += biq_total;
lowA = mem; mem += biq_total; lowB = mem; mem += biq_total; lowC = mem; mem += biq_total;
bezCompF = mem; mem += bez_total; bezCompS = mem; mem += bez_total;
i = 0;
loop(mem, 0[i] = 0; i += 1;);

highLIIR = 0; highRIIR = 0; midLIIR = 0; midRIIR = 0; lowLIIR = 0; lowRIIR = 0;
bezCompF[bez_cycle] = 1.0; bezCompS[bez_cycle] = 1.0; bezMaxF = 0;
lastSampleL = 0; lastSampleR = 0;
wasPosClipL = 0; wasNegClipL = 0; wasPosClipR = 0; wasNegClipR = 0;
inTrimA = 0.5; inTrimB = 0.5;
fpdL = 1; while (fpdL < 16386) ( fpdL = floor(rand(2147483647)); );
fpdR = 1; while (fpdR < 16386) ( fpdR = floor(rand(2147483647)); );
cachedRate = cachedHigh = cachedHmid = cachedLmid = cachedBass = -1;
cachedHighF = cachedHmidF = cachedLmidF = cachedBassF = -1;
cachedThresh = cachedFader = -1;

@sample
(srate != cachedRate || high != cachedHigh || hmid != cachedHmid || lmid != cachedLmid || bass != cachedBass || highF != cachedHighF || hmidF != cachedHmidF || lmidF != cachedLmidF || bassF != cachedBassF || thresh != cachedThresh || fader != cachedFader) ? (
cachedRate = srate; cachedHigh = high; cachedHmid = hmid; cachedLmid = lmid; cachedBass = bass;
cachedHighF = highF; cachedHmidF = hmidF; cachedLmidF = lmidF; cachedBassF = bassF;
cachedThresh = thresh; cachedFader = fader;
overallscale = max(srate / 44100.0, 0.000001);
spacing = floor(overallscale * 2.0);
spacing < 2 ? spacing = 2;
spacing > 32 ? spacing = 32;

trebleGain = (high - 0.5) * 2.0; trebleGain = 1.0 + (trebleGain * abs(trebleGain) * abs(trebleGain));
highmidGain = (hmid - 0.5) * 2.0; highmidGain = 1.0 + (highmidGain * abs(highmidGain) * abs(highmidGain));
lowmidGain = (lmid - 0.5) * 2.0; lowmidGain = 1.0 + (lowmidGain * abs(lowmidGain) * abs(lowmidGain));
bassGain = (bass - 0.5) * 2.0; bassGain = 1.0 + (bassGain * abs(bassGain) * abs(bassGain));
eqFlat = trebleGain == 1.0 && highmidGain == 1.0 && lowmidGain == 1.0 && bassGain == 1.0;

trebleRef = highF - 0.5; highmidRef = hmidF - 0.5; lowmidRef = lmidF - 0.5; bassRef = bassF - 0.5;
highNorm = 0.75 + ((trebleRef + trebleRef + trebleRef + highmidRef) * 0.125);
bassNorm = 0.25 + ((lowmidRef + bassRef + bassRef + bassRef) * 0.125);
midNorm = (highNorm * 0.5) + (bassNorm * 0.5) + ((highmidRef + lowmidRef) * 0.125);
highQ = max(min(1.0 + (highmidRef - trebleRef), 4.0), 0.125);
midQ = max(min(1.0 + (lowmidRef - highmidRef), 4.0), 0.125);
lowQ = max(min(1.0 + (bassRef - lowmidRef), 4.0), 0.125);

highA[biq_freq] = (pow(highNorm, 3) * 20000.0) / srate;
highA[biq_freq] = max(min(highA[biq_freq], 0.4999), 0.00025);
highB[biq_freq] = highA[biq_freq]; highC[biq_freq] = highA[biq_freq];
highFreqHz = pow(highNorm, 3) * 20000.0;
omega = 2.0 * $pi * (highFreqHz / srate); biqK = 2.0 - cos(omega); highCoef = -sqrt((biqK * biqK) - 1.0) + biqK;
highA[biq_reso] = 2.24697960 * highQ; highB[biq_reso] = 0.80193774 * highQ; highC[biq_reso] = 0.55495813 * highQ;

midA[biq_freq] = (pow(midNorm, 3) * 20000.0) / srate;
midA[biq_freq] = max(min(midA[biq_freq], 0.4999), 0.00025);
midB[biq_freq] = midA[biq_freq]; midC[biq_freq] = midA[biq_freq];
midFreqHz = pow(midNorm, 3) * 20000.0;
omega = 2.0 * $pi * (midFreqHz / srate); biqK = 2.0 - cos(omega); midCoef = -sqrt((biqK * biqK) - 1.0) + biqK;
midA[biq_reso] = 2.24697960 * midQ; midB[biq_reso] = 0.80193774 * midQ; midC[biq_reso] = 0.55495813 * midQ;

lowA[biq_freq] = (pow(bassNorm, 3) * 20000.0) / srate;
lowA[biq_freq] = max(min(lowA[biq_freq], 0.4999), 0.00025);
lowB[biq_freq] = lowA[biq_freq]; lowC[biq_freq] = lowA[biq_freq];
lowFreqHz = pow(bassNorm, 3) * 20000.0;
omega = 2.0 * $pi * (lowFreqHz / srate); biqK = 2.0 - cos(omega); lowCoef = -sqrt((biqK * biqK) - 1.0) + biqK;
lowA[biq_reso] = 2.24697960 * lowQ; lowB[biq_reso] = 0.80193774 * lowQ; lowC[biq_reso] = 0.55495813 * lowQ;

aw_set_lp(highA, highA[biq_freq], highA[biq_reso]); aw_set_lp(highB, highB[biq_freq], highB[biq_reso]); aw_set_lp(highC, highC[biq_freq], highC[biq_reso]);
aw_set_lp(midA, midA[biq_freq], midA[biq_reso]); aw_set_lp(midB, midB[biq_freq], midB[biq_reso]); aw_set_lp(midC, midC[biq_freq], midC[biq_reso]);
aw_set_lp(lowA, lowA[biq_freq], lowA[biq_reso]); aw_set_lp(lowB, lowB[biq_freq], lowB[biq_reso]); aw_set_lp(lowC, lowC[biq_freq], lowC[biq_reso]);

bezCThresh = pow(1.0 - thresh, 6.0) * 8.0;
bezRez = pow(1.0 - thresh, 12.360679774997898) / overallscale;
bezRez = min(max(bezRez, 0.00001), 1.0);
stepped = 999999; bezRez > 0.000001 ? stepped = floor(1.0 / bezRez);
bezRez = 0.99999999 / stepped;
bezTrim = 1.0 - (bezRez * (stepped / (stepped + 1.0)));
sloRez = pow(1.0 - thresh, 10.0) / overallscale;
sloRez = min(max(sloRez, 0.00001), 1.0);
stepped = 999999; sloRez > 0.000001 ? stepped = floor(1.0 / sloRez);
sloRez = 0.99999999 / stepped;
sloTrim = 1.0 - (sloRez * (stepped / (stepped + 1.0)));

// C++ ramps J over each host process callback. RJDSP @sample is a one-sample
// callback in the stock execution path, making temp=0 and gain=inTrimB.
inTrimA = inTrimB; inTrimB = fader * 2.0; gain = inTrimB;
);

inputSampleL = spl0; inputSampleR = spl1;
abs(inputSampleL) < 0.0000000000000000000000118 ? inputSampleL = aw_u32(fpdL) * 0.0000000000000000118;
abs(inputSampleR) < 0.0000000000000000000000118 ? inputSampleR = aw_u32(fpdR) * 0.0000000000000000118;

// SmoothEQ2: LEFT, three biquad crossover passes plus exponential pass.
eqFlat == 0 ? (
trebleL = inputSampleL;
outSample = (trebleL * highA[biq_a0]) + highA[biq_sL1]; highA[biq_sL1] = (trebleL * highA[biq_a1]) - (outSample * highA[biq_b1]) + highA[biq_sL2]; highA[biq_sL2] = (trebleL * highA[biq_a2]) - (outSample * highA[biq_b2]); highmidL = outSample; trebleL -= highmidL;
outSample = (highmidL * midA[biq_a0]) + midA[biq_sL1]; midA[biq_sL1] = (highmidL * midA[biq_a1]) - (outSample * midA[biq_b1]) + midA[biq_sL2]; midA[biq_sL2] = (highmidL * midA[biq_a2]) - (outSample * midA[biq_b2]); lowmidL = outSample; highmidL -= lowmidL;
outSample = (lowmidL * lowA[biq_a0]) + lowA[biq_sL1]; lowA[biq_sL1] = (lowmidL * lowA[biq_a1]) - (outSample * lowA[biq_b1]) + lowA[biq_sL2]; lowA[biq_sL2] = (lowmidL * lowA[biq_a2]) - (outSample * lowA[biq_b2]); bassL = outSample; lowmidL -= bassL;
trebleL = (bassL * bassGain) + (lowmidL * lowmidGain) + (highmidL * highmidGain) + (trebleL * trebleGain);

outSample = (trebleL * highB[biq_a0]) + highB[biq_sL1]; highB[biq_sL1] = (trebleL * highB[biq_a1]) - (outSample * highB[biq_b1]) + highB[biq_sL2]; highB[biq_sL2] = (trebleL * highB[biq_a2]) - (outSample * highB[biq_b2]); highmidL = outSample; trebleL -= highmidL;
outSample = (highmidL * midB[biq_a0]) + midB[biq_sL1]; midB[biq_sL1] = (highmidL * midB[biq_a1]) - (outSample * midB[biq_b1]) + midB[biq_sL2]; midB[biq_sL2] = (highmidL * midB[biq_a2]) - (outSample * midB[biq_b2]); lowmidL = outSample; highmidL -= lowmidL;
outSample = (lowmidL * lowB[biq_a0]) + lowB[biq_sL1]; lowB[biq_sL1] = (lowmidL * lowB[biq_a1]) - (outSample * lowB[biq_b1]) + lowB[biq_sL2]; lowB[biq_sL2] = (lowmidL * lowB[biq_a2]) - (outSample * lowB[biq_b2]); bassL = outSample; lowmidL -= bassL;
trebleL = (bassL * bassGain) + (lowmidL * lowmidGain) + (highmidL * highmidGain) + (trebleL * trebleGain);

outSample = (trebleL * highC[biq_a0]) + highC[biq_sL1]; highC[biq_sL1] = (trebleL * highC[biq_a1]) - (outSample * highC[biq_b1]) + highC[biq_sL2]; highC[biq_sL2] = (trebleL * highC[biq_a2]) - (outSample * highC[biq_b2]); highmidL = outSample; trebleL -= highmidL;
outSample = (highmidL * midC[biq_a0]) + midC[biq_sL1]; midC[biq_sL1] = (highmidL * midC[biq_a1]) - (outSample * midC[biq_b1]) + midC[biq_sL2]; midC[biq_sL2] = (highmidL * midC[biq_a2]) - (outSample * midC[biq_b2]); lowmidL = outSample; highmidL -= lowmidL;
outSample = (lowmidL * lowC[biq_a0]) + lowC[biq_sL1]; lowC[biq_sL1] = (lowmidL * lowC[biq_a1]) - (outSample * lowC[biq_b1]) + lowC[biq_sL2]; lowC[biq_sL2] = (lowmidL * lowC[biq_a2]) - (outSample * lowC[biq_b2]); bassL = outSample; lowmidL -= bassL;
trebleL = (bassL * bassGain) + (lowmidL * lowmidGain) + (highmidL * highmidGain) + (trebleL * trebleGain);

highLIIR = (highLIIR * highCoef) + (trebleL * (1.0 - highCoef)); highmidL = highLIIR; trebleL -= highmidL;
midLIIR = (midLIIR * midCoef) + (highmidL * (1.0 - midCoef)); lowmidL = midLIIR; highmidL -= lowmidL;
lowLIIR = (lowLIIR * lowCoef) + (lowmidL * (1.0 - lowCoef)); bassL = lowLIIR; lowmidL -= bassL;
inputSampleL = (bassL * bassGain) + (lowmidL * lowmidGain) + (highmidL * highmidGain) + (trebleL * trebleGain);

// SmoothEQ2: RIGHT.
trebleR = inputSampleR;
outSample = (trebleR * highA[biq_a0]) + highA[biq_sR1]; highA[biq_sR1] = (trebleR * highA[biq_a1]) - (outSample * highA[biq_b1]) + highA[biq_sR2]; highA[biq_sR2] = (trebleR * highA[biq_a2]) - (outSample * highA[biq_b2]); highmidR = outSample; trebleR -= highmidR;
outSample = (highmidR * midA[biq_a0]) + midA[biq_sR1]; midA[biq_sR1] = (highmidR * midA[biq_a1]) - (outSample * midA[biq_b1]) + midA[biq_sR2]; midA[biq_sR2] = (highmidR * midA[biq_a2]) - (outSample * midA[biq_b2]); lowmidR = outSample; highmidR -= lowmidR;
outSample = (lowmidR * lowA[biq_a0]) + lowA[biq_sR1]; lowA[biq_sR1] = (lowmidR * lowA[biq_a1]) - (outSample * lowA[biq_b1]) + lowA[biq_sR2]; lowA[biq_sR2] = (lowmidR * lowA[biq_a2]) - (outSample * lowA[biq_b2]); bassR = outSample; lowmidR -= bassR;
trebleR = (bassR * bassGain) + (lowmidR * lowmidGain) + (highmidR * highmidGain) + (trebleR * trebleGain);

outSample = (trebleR * highB[biq_a0]) + highB[biq_sR1]; highB[biq_sR1] = (trebleR * highB[biq_a1]) - (outSample * highB[biq_b1]) + highB[biq_sR2]; highB[biq_sR2] = (trebleR * highB[biq_a2]) - (outSample * highB[biq_b2]); highmidR = outSample; trebleR -= highmidR;
outSample = (highmidR * midB[biq_a0]) + midB[biq_sR1]; midB[biq_sR1] = (highmidR * midB[biq_a1]) - (outSample * midB[biq_b1]) + midB[biq_sR2]; midB[biq_sR2] = (highmidR * midB[biq_a2]) - (outSample * midB[biq_b2]); lowmidR = outSample; highmidR -= lowmidR;
outSample = (lowmidR * lowB[biq_a0]) + lowB[biq_sR1]; lowB[biq_sR1] = (lowmidR * lowB[biq_a1]) - (outSample * lowB[biq_b1]) + lowB[biq_sR2]; lowB[biq_sR2] = (lowmidR * lowB[biq_a2]) - (outSample * lowB[biq_b2]); bassR = outSample; lowmidR -= bassR;
trebleR = (bassR * bassGain) + (lowmidR * lowmidGain) + (highmidR * highmidGain) + (trebleR * trebleGain);

outSample = (trebleR * highC[biq_a0]) + highC[biq_sR1]; highC[biq_sR1] = (trebleR * highC[biq_a1]) - (outSample * highC[biq_b1]) + highC[biq_sR2]; highC[biq_sR2] = (trebleR * highC[biq_a2]) - (outSample * highC[biq_b2]); highmidR = outSample; trebleR -= highmidR;
outSample = (highmidR * midC[biq_a0]) + midC[biq_sR1]; midC[biq_sR1] = (highmidR * midC[biq_a1]) - (outSample * midC[biq_b1]) + midC[biq_sR2]; midC[biq_sR2] = (highmidR * midC[biq_a2]) - (outSample * midC[biq_b2]); lowmidR = outSample; highmidR -= lowmidR;
outSample = (lowmidR * lowC[biq_a0]) + lowC[biq_sR1]; lowC[biq_sR1] = (lowmidR * lowC[biq_a1]) - (outSample * lowC[biq_b1]) + lowC[biq_sR2]; lowC[biq_sR2] = (lowmidR * lowC[biq_a2]) - (outSample * lowC[biq_b2]); bassR = outSample; lowmidR -= bassR;
trebleR = (bassR * bassGain) + (lowmidR * lowmidGain) + (highmidR * highmidGain) + (trebleR * trebleGain);

highRIIR = (highRIIR * highCoef) + (trebleR * (1.0 - highCoef)); highmidR = highRIIR; trebleR -= highmidR;
midRIIR = (midRIIR * midCoef) + (highmidR * (1.0 - midCoef)); lowmidR = midRIIR; highmidR -= lowmidR;
lowRIIR = (lowRIIR * lowCoef) + (lowmidR * (1.0 - lowCoef)); bassR = lowRIIR; lowmidR -= bassR;
inputSampleR = (bassR * bassGain) + (lowmidR * lowmidGain) + (highmidR * highmidGain) + (trebleR * trebleGain);
);

// Current stepped Bezier Dynamics2.
bezCThresh > 0.0 ? (
bezCThresh > 0.0 ? ( inputSampleL *= ((bezCThresh * 0.5) + 1.0); inputSampleR *= ((bezCThresh * 0.5) + 1.0); );
bezCompF[bez_cycle] += bezRez;
bezCompF[bez_SampL] += abs(inputSampleL) * bezRez; bezCompF[bez_SampR] += abs(inputSampleR) * bezRez;
bezMaxF = max(bezMaxF, max(abs(inputSampleL), abs(inputSampleR)));
bezCompF[bez_cycle] > bezTrim ? (
    bezCompF[bez_cycle] = 0.0;
    bezCompF[bez_CL] = bezCompF[bez_BL]; bezCompF[bez_BL] = bezCompF[bez_AL]; bezCompF[bez_AL] = bezCompF[bez_SampL]; bezCompF[bez_SampL] = 0.0;
    bezCompF[bez_CR] = bezCompF[bez_BR]; bezCompF[bez_BR] = bezCompF[bez_AR]; bezCompF[bez_AR] = bezCompF[bez_SampR]; bezCompF[bez_SampR] = 0.0;
    bezMaxF = 0.0;
);
bezCompS[bez_cycle] += sloRez;
bezCompS[bez_SampL] += abs(inputSampleL) * sloRez; bezCompS[bez_SampR] += abs(inputSampleR) * sloRez;
bezCompS[bez_cycle] > sloTrim ? (
    bezCompS[bez_cycle] = 0.0;
    bezCompS[bez_CL] = bezCompS[bez_BL]; bezCompS[bez_BL] = bezCompS[bez_AL]; bezCompS[bez_AL] = bezCompS[bez_SampL]; bezCompS[bez_SampL] = 0.0;
    bezCompS[bez_CR] = bezCompS[bez_BR]; bezCompS[bez_BR] = bezCompS[bez_AR]; bezCompS[bez_AR] = bezCompS[bez_SampR]; bezCompS[bez_SampR] = 0.0;
);
X = bezCompF[bez_cycle];
CBAFL = (bezCompF[bez_BL] + (bezCompF[bez_CL] * (1.0-X) * (1.0-X)) + (bezCompF[bez_BL] * 2.0 * (1.0-X) * X) + (bezCompF[bez_AL] * X * X)) * 0.5;
CBAFR = (bezCompF[bez_BR] + (bezCompF[bez_CR] * (1.0-X) * (1.0-X)) + (bezCompF[bez_BR] * 2.0 * (1.0-X) * X) + (bezCompF[bez_AR] * X * X)) * 0.5;
X = bezCompS[bez_cycle];
CBASL = (bezCompS[bez_BL] + (bezCompS[bez_CL] * (1.0-X) * (1.0-X)) + (bezCompS[bez_BL] * 2.0 * (1.0-X) * X) + (bezCompS[bez_AL] * X * X)) * 0.5;
CBASR = (bezCompS[bez_BR] + (bezCompS[bez_CR] * (1.0-X) * (1.0-X)) + (bezCompS[bez_BR] * 2.0 * (1.0-X) * X) + (bezCompS[bez_AR] * X * X)) * 0.5;
CBAMax = max(CBASL, CBAFL); CBAMax > 0.0 ? CBAMax = 1.0 / CBAMax;
CBAFade = ((CBASL * -CBAMax) + (CBAFL * CBAMax) + 1.0) * 0.5;
bezCThresh > 0.0 ? inputSampleL *= 1.0 - min(((CBASL * (1.0-CBAFade)) + (CBAFL * CBAFade)) * bezCThresh, 1.0);
CBAMax = max(CBASR, CBAFR); CBAMax > 0.0 ? CBAMax = 1.0 / CBAMax;
CBAFade = ((CBASR * -CBAMax) + (CBAFR * CBAMax) + 1.0) * 0.5;
bezCThresh > 0.0 ? inputSampleR *= 1.0 - min(((CBASR * (1.0-CBAFade)) + (CBAFR * CBAFade)) * bezCThresh, 1.0);
);

inputSampleL *= gain; inputSampleR *= gain;

// Current ClipOnly3 output protection.
noise = 1.0 - ((aw_u32(fpdL) / 4294967295.0) * 0.076);
wasPosClipL ? ( inputSampleL < lastSampleL ? lastSampleL = (0.9085097*noise)+(inputSampleL*(1.0-noise)) : lastSampleL = 0.94; );
wasPosClipL = 0; inputSampleL > 0.9085097 ? (wasPosClipL=1; inputSampleL=(0.9085097*noise)+(lastSampleL*(1.0-noise)););
